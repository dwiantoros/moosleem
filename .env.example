CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=ganti-password-admin
CMS_SESSION_SECRET=ganti-dengan-random-string-panjang

# Untuk production, pakai Turso free database.
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Push Notification VAPID Keys
# Generate with: npx web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=your-public-key-here
PUSH_VAPID_PRIVATE_KEY=your-private-key-here
PUSH_VAPID_SUBJECT=mailto:your-email@example.com

# Cron secret untuk endpoint /api/cron/push-prayer
CRON_SECRET=your-secret-cron-key-here

# Optional: Vercel KV (prioritas utama untuk subscription storage)
# Jika kosong, app fallback ke Turso/libsql.
# KV_REST_API_URL=https://your-kv-instance.vercel.sh
# KV_REST_API_TOKEN=your-kv-token-here
